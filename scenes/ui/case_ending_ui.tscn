[node name="Victim" type="Label" parent="Overlay/IntroCenter/IntroContent"]
layout_mode = 2
text = "VICTIM: BRAMBLE BEAR"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 23

[node name="Briefing" type="Label" parent="Overlay/IntroCenter/IntroContent"]
layout_mode = 2
text = "You're the department's best detective — a reputation earned by seeing what others can't.\nThat happens to be especially useful when you're a bat.\n\nBramble Bear, owner of the local bakery, was found dead inside his family's cave.\nThe initial investigation has ruled his death a homicide.\n\nCause of death: Severe blunt-force trauma to the head.\n\nFive individuals were seen entering and leaving the cave that day.\n\nYour assignment is simple:\nInvestigate the cave. Determine what killed Bramble. Determine why. Determine who was responsible.\n\nBuild your theory carefully. An accusation without enough connecting evidence won't hold up."
horizontal_alignment = 1
autowrap_mode = 2
theme_override_colors/font_color = Color(0.84, 0.87, 0.89, 1)
theme_override_font_sizes/font_size = 17

[node name="Continue" type="Button" parent="Overlay/IntroCenter/IntroContent"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "CONTINUE AVAILABLE SHORTLY"
disabled = true

